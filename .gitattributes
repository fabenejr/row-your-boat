# Normalize line endings in the repository (LF), let Git convert on checkout.
* text=auto

# Visual Studio and PowerShell files keep Windows line endings.
*.sln    text eol=crlf
*.csproj text eol=crlf
*.props  text eol=crlf
*.ps1    text eol=crlf

# Binary files.
*.png binary
*.dll binary
*.zip binary
